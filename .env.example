# ==============================================================================
# MediaFlow Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# Never commit actual secret keys or sensitive credentials into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME MODE
# ------------------------------------------------------------------------------
# The human-readable project title
PROJECT_NAME="MediaFlow"

# Set to True only during local development for verbose stack traces and debug output
DEBUG=False

# Environment identifier: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Application log level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# High-entropy random secret key used for signing JWTs and session tokens.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_or_base64_string

# Algorithm used for JWT encoding/decoding
ALGORITHM=HS256

# JWT Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Max API requests permitted per client IP per minute
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Desktop Local / Embedded mode:
DATABASE_URL=sqlite:///./downloads.db

# Headless / Server / Docker Compose mode (PostgreSQL):
# DATABASE_URL=postgresql://mediadock:mediadock_password@localhost:5432/mediadock
# When running inside docker-compose network:
# DATABASE_URL=postgresql://mediadock:mediadock_password@db:5432/mediadock

# ------------------------------------------------------------------------------
# 4. CELERY & MESSAGE BROKER (Headless / Distributed Mode)
# ------------------------------------------------------------------------------
# Redis connection URL for task queuing and result caching
REDIS_URL=redis://localhost:6379/0
# When running inside docker-compose network:
# REDIS_URL=redis://redis:6379/0

# Optional explicit broker overrides
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. STORAGE & PATH CONFIGURATION
# ------------------------------------------------------------------------------
# Local directory where media downloads and temporary `.part` files are stored
DOWNLOADS_DIR=downloads

# Maximum concurrent media downloads
MAX_CONCURRENT_DOWNLOADS=3

# Optional S3 Cloud Storage Integration (Set to True if offloading completed files)
USE_S3=False
S3_BUCKET=my-mediaflow-bucket
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ------------------------------------------------------------------------------
# 6. EXTERNAL TOOL PATHS (Optional Overrides)
# ------------------------------------------------------------------------------
# By default, MediaFlow locates `ffmpeg` and `ffprobe` on the system PATH.
# Override these if bundled or installed in non-standard directories:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YT_DLP_PATH=/usr/local/bin/yt-dlp
