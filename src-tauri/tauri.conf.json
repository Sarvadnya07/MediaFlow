{
    "$schema":  "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
    "productName":  "MediaDock",
    "version":  "0.1.0",
    "identifier":  "com.mediadock.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../frontend/dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "MediaDock",
                                    "width":  1080,
                                    "height":  720,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/mediadock-sidecar"
                                   ]
               }
}